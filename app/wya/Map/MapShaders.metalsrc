#include <metal_stdlib>
using namespace metal;

// The camera: a centre in map units, a scale in points per map unit, the view in points.
struct Cam {
    float2 c;
    float k;
    float time;
    float2 view;
    float2 pad;
};

inline float2 toScreen(float2 p, constant Cam& cam) { return (p - cam.c) * cam.k + cam.view * 0.5; }
inline float4 toClip(float2 s, constant Cam& cam) {
    return float4(s.x / cam.view.x * 2.0 - 1.0, 1.0 - s.y / cam.view.y * 2.0, 0.0, 1.0);
}

// MARK: the fans that mark land in the stencil (even-odd), no colour
// each point from its place on the coarser level's outline to its own, as far as the zoom is into the band (morph)
vertex float4 fanVertex(uint vid [[vertex_id]],
                        const device float2* pts [[buffer(0)]],
                        constant Cam& cam [[buffer(1)]],
                        const device float2* from [[buffer(2)]],
                        constant float& morph [[buffer(3)]]) {
    return toClip(toScreen(mix(from[vid], pts[vid], morph), cam), cam);
}
fragment float4 fanFragment() { return float4(0.0); }
// one country's shape into a mask: every fan triangle inverts what is there (one minus the mask, by the blend), so the
// fans fill even-odd as the stencil does
fragment float4 maskFragment() { return float4(1.0); }

// MARK: the relief: sea by depth, land by height, drawn on a one-degree grid laid in Equal Earth
struct GridV {
    float4 position [[position]];
    float2 uv;
};
vertex GridV reliefVertex(uint vid [[vertex_id]],
                          const device float4* g [[buffer(0)]],
                          constant Cam& cam [[buffer(1)]]) {
    float4 q = g[vid];
    GridV o;
    o.position = toClip(toScreen(q.xy, cam), cam);
    o.uv = q.zw;
    return o;
}

struct Look {
    float4 tint;     // the colour a kind multiplies or lays flat
    float kind;      // 0 sea (and lakes), 1 plain land, 2 land multiplied by tint, 3 flat tint, 5 land round a continent
    float texelU;
    float texelV;
    float pad;
    float4 clip;     // a fill front (Part 1.5): its origin (map units), its radius (map units), 1 when on
    float4 clip2;    // x pixels per point, y Style Simple, z the pattern for Differentiate Without Colour (1 hatch, 2 dots)
    float4 det;      // the open country's finer relief: its box in the world picture (u0 v0 u1 v1)
    float4 det2;     // its texel (u, v), z 1 when it is in
    float4 sun;      // THE REAL SUN: x the subsolar latitude, y its longitude (radians), z 1 when on, w the night's depth
};

// THE WORLD'S LIGHT: the relief lit by where the sun really is now. For a point (uv: longitude, latitude), the sun's
// height over its horizon and its direction along the ground. Out: xyz the light in the relief's frame (x east, y
// south, z up), w how far into the day (0 night, 1 day)
inline float4 sunLight(float2 uv, float4 sun) {
    float lat = (0.5 - uv.y) * M_PI_F, lon = (uv.x - 0.5) * 2.0 * M_PI_F;
    float dl = sun.y - lon;
    float sd = sin(sun.x), cd = cos(sun.x);
    float up = sin(lat) * sd + cos(lat) * cd * cos(dl);
    float east = cd * sin(dl);
    float north = cos(lat) * sd - sin(lat) * cd * cos(dl);
    float2 h = float2(east, -north);
    float hl = length(h);
    h = hl > 1e-4 ? h / hl : float2(-0.7071, -0.7071);
    // always from the north side (mirrored when the sun is to the south): lit from the south, as the real sun mostly
    // is for the north, hills read as hollows and valleys as ridges (relief inversion), which is why every good map
    // lights from the north-west; the light still swings east to west with the day
    h.y = -abs(h.y);
    if (abs(h.y) < 0.35) h = normalize(float2(h.x, -0.35));
    // never a grazing light (it blows slopes out into black and white): at least 28 degrees up for the shading
    float e = max(asin(clamp(up, -1.0, 1.0)), 0.49);
    float3 L = float3(h * cos(e), sin(e));
    // the day, with a soft twilight about 12 degrees deep (civil to nautical); the sign of how far the sun is up rides
    // in the light's length so the warm low light can be told (low sun: up near 0)
    float day = smoothstep(-0.21, 0.06, up);
    float warm = day * (1.0 - smoothstep(0.02, 0.32, up));
    return float4(L * (1.0 + warm), day);
}
// the night side: the same land and sea, a little dimmer and cooler, never dark; near sunrise and sunset the day side
// warms a little, as low light does
inline float3 nightSide(float3 c, float4 sunL, float depth) {
    float warm = length(sunL.xyz) - 1.0;
    float3 night = c * float3(0.86, 0.89, 0.96);
    float3 lit = c * mix(float3(1.0), float3(1.035, 1.0, 0.94), warm);
    return mix(mix(c, night, depth), lit, sunL.w);
}

// DIFFERENTIATE WITHOUT COLOUR (Part 1.14): stamped land hatched (0.5 pt lines of 50% ink at 45 degrees, 4 pt apart),
// wished land dotted (1 pt dots of 50% ink, 5 pt apart), in screen points so they keep their size at every zoom
static float3 pattern(float3 c, float kind, float2 px, float ppp) {
    float2 p = px / max(ppp, 1.0);
    if (kind > 0.5 && kind < 1.5) {
        float d = fmod(abs(p.x + p.y) * 0.70710678, 4.0);
        float a = clamp(0.5 - min(d, 4.0 - d) + 0.25, 0.0, 1.0);
        return mix(c, c * 0.5, a);
    }
    if (kind > 1.5) {
        float2 q = fmod(p, 5.0) - 2.5;
        float a = clamp(0.5 - length(q) + 0.5, 0.0, 1.0);
        return mix(c, c * 0.5, a);
    }
    return c;
}

constant float3 WHITE = float3(1.0);
constant float3 BLUE = float3(0.4706, 0.6824, 0.9725);       // 78AEF8
constant float3 BEIGE_DARK = float3(0.7373, 0.7216, 0.7137); // BCB8B6
constant float3 CREAM = float3(0.9843, 0.9647, 0.9490);      // FBF6F2

inline float3 seaColour(float d) {
    // our blue down to near-white in the shallows, never washed out
    float3 shallow = mix(WHITE, BLUE, 0.20);
    float t = pow(clamp(d / 0.78, 0.0, 1.0), 0.85);
    return mix(shallow, BLUE, t);
}


// THE WORLD'S LIGHT, ITS SHADOWS (25 Nov, direction A's next step): from a point, steps toward the sun over the world's
// heights; where higher ground stands in the way the point is in its shade, softened by how far above the light's path
// the ground came. The heights are drawn about two and a half times taller for the shadows than for the slopes (one
// unit of height 36 texels across, the slopes' 14): at the true scale a mountain's shade was too short to see at any
// zoom the relief shows, so, as a painter would, the shadows are lengthened. 0 lit, 1 in full shade.
inline float castShade(texture2d<float> rel, sampler s, float2 uv, float h0, float3 L, float2 texel) {
    float2 flat = L.xy;
    float run = length(flat);
    if (run < 1e-4) return 0.0;
    float2 dir = flat / run;
    float rise = (L.z / run) / 36.0;          // the light's path climbs this much height a texel
    float over = 0.0;
    for (int i = 1; i <= 28; i++) {
        float d = float(i) * 2.0;
        float hh = rel.sample(s, uv + dir * texel * d).g;
        over = max(over, hh - (h0 + rise * d));
    }
    return smoothstep(0.0, 0.08, over);
}

fragment float4 reliefFragment(GridV in [[stage_in]],
                               texture2d<float> rel [[texture(0)]],
                               texture2d<float> det [[texture(1)]],
                               sampler s [[sampler(0)]],
                               constant Look& look [[buffer(0)]],
                               constant Cam& cam [[buffer(1)]]) {
    // a fill front: only inside its circle, with a 1 pt edge (an edge, not a fade)
    float front = 1.0;
    if (look.clip.w > 0.5) {
        float2 sp = in.position.xy / look.clip2.x;
        float2 m = cam.c + (sp - cam.view * 0.5) / cam.k;
        float d = length(m - look.clip.xy) * cam.k, r = look.clip.z * cam.k;
        front = clamp(r - d + 0.5, 0.0, 1.0);
    }
    int kind = int(look.kind + 0.5);
    // (the screen's change of uv taken once, before any branch: a derivative inside one is undefined where a quad's
    // pixels split)
    float2 fw = fwidth(in.uv);
    float2 dh = rel.sample(s, in.uv).rg;
    // THE OPEN COUNTRY'S FINER RELIEF: inside its box its own picture, eased in over the box's outer edge so no seam;
    // its own land only (plain and coloured): the sea and the world round it keep the world's picture, so the box
    // never shows as a patch on them
    float wd = 0.0;
    float2 du = float2(0.0);
    if (look.det2.z > 0.5 && (kind == 1 || kind == 2)) {
        float2 span = look.det.zw - look.det.xy;
        du = (in.uv - look.det.xy) / span;
        // (a country across the date line has its box past u = 1: its far side, drawn at u near 0, found a world
        // over)
        if (du.x < 0.0) { float x = (in.uv.x + 1.0 - look.det.x) / span.x; if (x <= 1.0) du.x = x; }
        else if (du.x > 1.0) { float x = (in.uv.x - 1.0 - look.det.x) / span.x; if (x >= 0.0) du.x = x; }
        float2 e = min(du, 1.0 - du);
        wd = smoothstep(0.0, 0.04, min(e.x, e.y));
        if (wd > 0.0) dh = mix(dh, det.sample(s, du).rg, wd);
    }
    // MAP SETTINGS' STYLE SIMPLE (Part 1.4): no relief; the sea blue 25% on cream, unmarked land cream, your colours
    // on white as on Detailed (so lime and blue read the same in both styles)
    if (look.clip2.y > 0.5) {
        if (kind == 0) return float4(mix(mix(CREAM, BLUE, 0.25), look.tint.rgb, look.tint.a), 1.0);
        if (kind == 3) return float4(look.tint.rgb, 1.0);
        float3 flat = kind == 2 ? pattern(WHITE * look.tint.rgb, look.clip2.z, in.position.xy, look.clip2.x) : CREAM;
        if (kind == 5) flat = mix(CREAM * look.tint.rgb, mix(CREAM, BLUE, 0.5), look.tint.a);
        if (kind == 6) flat = mix(CREAM * look.tint.rgb, CREAM * mix(WHITE, BLUE, 0.20), look.tint.a);
        if (look.pad > 0.0 || look.clip.w > 0.5) {
            float a = (look.pad > 0.0 ? look.pad : 1.0) * front;
            return float4(flat * a, a);
        }
        return float4(flat, 1.0);
    }
    float4 sunL = look.sun.z > 0.5 ? sunLight(in.uv, look.sun) : float4(0.0, 0.0, 1.0, 1.0);
    if (kind == 0) {
        // outside the real world (past ±180°) the depth deepens into open ocean over 25°, so no ghost of the other side
        float out = max(-in.uv.x, in.uv.x - 1.0);
        float d = out > 0.0 ? mix(dh.r, 0.9, smoothstep(0.0, 0.07, out)) : dh.r;
        // on a continent's map the sea goes into the flat blue (tint.rgb, by tint.a)
        float3 sea = mix(seaColour(d), look.tint.rgb, look.tint.a);
        if (look.sun.z > 0.5) sea = nightSide(sea, sunL, look.sun.w);
        return float4(sea, 1.0);
    }
    if (kind == 3) return float4(look.tint.rgb, 1.0);
    // land: white to grey by height, with a soft light from the north-west so the mountains read the way Apple Maps'
    // do
    float h = dh.g;
    float hl = rel.sample(s, in.uv - float2(look.texelU, 0)).g;
    float hr = rel.sample(s, in.uv + float2(look.texelU, 0)).g;
    float hu = rel.sample(s, in.uv - float2(0, look.texelV)).g;
    float hd = rel.sample(s, in.uv + float2(0, look.texelV)).g;
    float2 grad = float2(hl - hr, hu - hd);
    if (wd > 0.0) {
        // the finer picture's slopes, across its own (smaller) texels, lifted part of the way back to the world's
        // strength so the hills read alike in both
        float2 dt = look.det2.xy / (look.det.zw - look.det.xy);
        float2 g2 = float2(det.sample(s, du - float2(dt.x, 0)).g - det.sample(s, du + float2(dt.x, 0)).g,
                           det.sample(s, du - float2(0, dt.y)).g - det.sample(s, du + float2(0, dt.y)).g);
        g2 *= pow(max(look.texelU / max(look.det2.x, 1e-9), 1.0), 0.45);
        grad = mix(grad, g2, wd);
    }
    float3 n = normalize(float3(grad.x * 7.0, grad.y * 7.0, 1.0));
    float3 L = normalize(float3(-1.0, -1.0, 1.6));
    // by day the real sun's direction; through twilight it turns back to the soft north-west light of the night
    if (look.sun.z > 0.5) L = normalize(mix(L, normalize(sunL.xyz), sunL.w));
    float shade = dot(n, L) / L.z;
    // zoomed in past the relief's own detail (a texel bigger than a few pixels) the hills would turn into soft grey
    // blobs, so the relief eases out and the land goes calm and flat instead
    // measured along the meridian too: near the poles the texture's rows are stretched sideways on the map, so across
    // alone it overstated the detail and Chukotka's coarse heights came out as grey patches
    float texelsPerPixel = min(fw.x / look.texelU, fw.y / look.texelV);
    // (inside the open country the finer picture's own texels)
    if (wd > 0.0) texelsPerPixel = mix(texelsPerPixel, min(fw.x / look.det2.x, fw.y / look.det2.y), wd);
    float detail = smoothstep(0.15, 0.5, texelsPerPixel);
    // zoomed in, the heights go almost all the way to calm land: a third of the height colour left there drew the
    // coarse heights as grey blotches
    float3 land = mix(WHITE, BEIGE_DARK, clamp(pow(h, 1.15) * 1.05, 0.0, 1.0) * mix(0.10, 1.0, detail));
    land *= mix(1.0, clamp(shade, 0.6, 1.25), 0.55 * detail);
    // the mountains' shadows by day, cool and soft (a painter's shade, a little blue, never black); gone at night and
    // where the relief itself eases out zoomed in
    if (look.sun.z > 0.5 && sunL.w > 0.0 && detail > 0.0) {
        float sh = castShade(rel, s, in.uv, rel.sample(s, in.uv).g, L, float2(look.texelU, look.texelV)) * sunL.w * detail;
        land *= mix(float3(1.0), float3(0.80, 0.84, 0.93), sh);
    }
    land = clamp(land, 0.0, 1.0);
    if (kind == 2) land = pattern(land * look.tint.rgb, look.clip2.z, in.position.xy, look.clip2.x);   // stamped lime soaks into the land; the Alps still show
    // YOUR LAND AS A MATERIAL, NOT PAINT: by day a slight sheen where its slopes face the sun, as a lacquered surface
    // catches light; never on the night side, never on flat ground (it follows the relief)
    if (kind == 2 && look.sun.z > 0.5 && look.clip2.z < 0.5) {
        float3 hv = normalize(normalize(L) + float3(0.0, 0.0, 1.0));
        float sheen = pow(max(dot(n, hv), 0.0), 60.0) * sunL.w * detail;
        float flatK = 1.0 - smoothstep(0.985, 0.999, n.z);
        land = min(land + sheen * flatK * 0.16, 1.0);
    }
    // THE LAND ROUND A CONTINENT (the old fadedLand, Slice 127l): away from the continent you're on the land stays
    // land, its own relief, mixed halfway toward our blue, and the colours on it go (tint.a: how far it has gone)
    if (kind == 5) land = mix(land * look.tint.rgb, mix(land, BLUE, 0.5), look.tint.a);
    // THE WORLD ROUND A COUNTRY'S OWN MAP: its own relief kept, multiplied by the sea's lightest blue (the shallows'
    // colour), its colours going (tint.a: how far it has gone)
    if (kind == 6) land = mix(land * look.tint.rgb, land * mix(WHITE, BLUE, 0.20), look.tint.a);
    if (look.sun.z > 0.5) land = nightSide(land, sunL, look.sun.w);
    // pad > 0: laid over what is there at that strength (premultiplied), so the borders under it go with it
    if (look.pad > 0.0 || look.clip.w > 0.5) {
        float a = (look.pad > 0.0 ? look.pad : 1.0) * front;
        return float4(land * a, a);
    }
    return float4(land, 1.0);
}

// MARK: borders and coasts: one thickness at every zoom, disputed lines one dashed line
struct LineStyle {
    float4 colour;
    float width;    // points
    float feather;  // points
    float dash;
    float gap;
};
struct LineV {
    float4 position [[position]];
    float across;
    float along;
    float dashed;
};
vertex LineV lineVertex(uint vid [[vertex_id]], uint iid [[instance_id]],
                        const device float* segs [[buffer(0)]],
                        constant Cam& cam [[buffer(1)]],
                        constant LineStyle& ls [[buffer(2)]],
                        constant float& morph [[buffer(3)]]) {
    // a segment: its ends, the same ends at the morph's start, its distance along the line, its kind
    const device float* g = segs + iid * 10;
    float2 a = toScreen(mix(float2(g[4], g[5]), float2(g[0], g[1]), morph), cam);
    float2 b = toScreen(mix(float2(g[6], g[7]), float2(g[2], g[3]), morph), cam);
    float2 d = b - a;
    float len = length(d);
    float2 dir = len > 1e-5 ? d / len : float2(1.0, 0.0);
    float2 nrm = float2(-dir.y, dir.x);
    float hw = ls.width * 0.5 + ls.feather;
    float t = (vid == 1 || vid == 3 || vid == 4) ? 1.0 : 0.0;
    float side = (vid == 2 || vid == 4 || vid == 5) ? 1.0 : -1.0;
    float2 p = mix(a, b, t) + nrm * side * hw + dir * (t * 2.0 - 1.0) * ls.feather;
    // a segment shrunk to nothing (a ring growing out of its own centre at the morph's start) draws nothing, not a dot
    if (len < 0.001) p = a;
    LineV o;
    o.position = toClip(p, cam);
    o.across = side * hw;
    float segLen = length(float2(g[2] - g[0], g[3] - g[1]));
    o.along = (g[8] + t * segLen) * cam.k;
    o.dashed = fmod(g[9], 2.0);
    return o;
}
// THE BORDERS BETWEEN REGIONS (A6.9): ten floats a segment, its ends and where they lie along their border (0 to 1).
// `q` is how much of each border shows: the parts within q/2 of either end, so a border draws in from both ends at
// once (q 0 to 1) and undraws back into them (1 to 0). A segment across the cut is cut there.
vertex LineV regionLineVertex(uint vid [[vertex_id]], uint iid [[instance_id]],
                              const device float* segs [[buffer(0)]],
                              constant Cam& cam [[buffer(1)]],
                              constant LineStyle& ls [[buffer(2)]],
                              constant float& q [[buffer(3)]]) {
    // two instances a segment: its part near the border's first end, and its part near the other end
    const device float* g = segs + (iid >> 1) * 10;
    bool second = (iid & 1u) == 1u;
    float2 A = float2(g[0], g[1]), B = float2(g[2], g[3]);
    float s0 = min(g[4], g[5]), s1 = max(g[4], g[5]);
    bool flip = g[4] > g[5];
    float h = q * 0.5;
    float lo = s0, hi = s1;
    if (q < 0.999) {
        if (second) { lo = max(s0, 1.0 - h); hi = s1; } else { lo = s0; hi = min(s1, h); }
    } else if (second) {
        hi = lo;
    }
    float span = max(s1 - s0, 1e-9);
    float ta = (lo - s0) / span, tb = (hi - s0) / span;
    if (flip) { ta = 1.0 - ta; tb = 1.0 - tb; }
    float2 a = toScreen(mix(A, B, ta), cam);
    float2 b = toScreen(mix(A, B, tb), cam);
    float2 d = b - a;
    float len = length(d);
    float2 dir = len > 1e-5 ? d / len : float2(1.0, 0.0);
    float2 nrm = float2(-dir.y, dir.x);
    float hw = ls.width * 0.5 + ls.feather;
    float t = (vid == 1 || vid == 3 || vid == 4) ? 1.0 : 0.0;
    float side = (vid == 2 || vid == 4 || vid == 5) ? 1.0 : -1.0;
    float2 p = mix(a, b, t) + nrm * side * hw + dir * (t * 2.0 - 1.0) * ls.feather;
    // nothing of it shows yet (or any more): no dot
    if (hi <= lo || len < 0.001) p = a;
    LineV o;
    o.position = toClip(p, cam);
    o.across = (hi <= lo) ? 1e4 : side * hw;
    o.along = 0.0;
    o.dashed = 0.0;
    return o;
}
struct FullV { float4 position [[position]]; float2 s; };
// ONE LINE, ONE STRENGTH: every segment was its own quad, laid over the last, so where a detailed coast has many
// short segments their ends piled up into a darker, thicker line than a border of a few long ones. Now the lines'
// coverage is drawn first into a texture of its own, taking the most of any segment at each pixel (max, never added),
// and laid over the map once, in 50% black.
fragment float4 lineCoverage(LineV in [[stage_in]], constant LineStyle& ls [[buffer(0)]]) {
    float d = abs(in.across);
    float a = clamp((ls.width * 0.5 + ls.feather * 0.5 - d) / ls.feather, 0.0, 1.0);
    if (in.dashed > 0.5 && fmod(in.along, ls.dash + ls.gap) > ls.dash) discard_fragment();
    // colour.a here is the set's strength: 1, or while the detail changes level the old set going and the new coming
    return float4(a * ls.colour.a);
}
fragment float4 lineComposite(FullV in [[stage_in]], texture2d<float> cov [[texture(0)]],
                              constant LineStyle& ls [[buffer(0)]]) {
    float c = cov.read(uint2(in.position.xy)).r * ls.colour.a;
    if (c <= 0.002) discard_fragment();
    return float4(ls.colour.rgb * c, c);
}
// THE LINES ON A COUNTRY'S OWN MAP: outside the open country (its mask grown by 2 pixels, so its own coast keeps its
// whole width) the lines go with the rest of the world, by `away`
fragment float4 lineCompositeFocus(FullV in [[stage_in]], texture2d<float> cov [[texture(0)]],
                                   texture2d<float> mask [[texture(1)]],
                                   constant LineStyle& ls [[buffer(0)]], constant float& away [[buffer(3)]]) {
    float c = cov.read(uint2(in.position.xy)).r * ls.colour.a;
    if (c <= 0.002) discard_fragment();
    int2 q = int2(in.position.xy);
    int2 size = int2(mask.get_width(), mask.get_height());
    float m = 0.0;
    for (int dy = -2; dy <= 2; dy += 2) {
        for (int dx = -2; dx <= 2; dx += 2) {
            m = max(m, mask.read(uint2(clamp(q + int2(dx, dy), int2(0), size - 1))).r);
        }
    }
    c *= mix(1.0, m, away);
    if (c <= 0.002) discard_fragment();
    return float4(ls.colour.rgb * c, c);
}
fragment float4 lineFragment(LineV in [[stage_in]], constant LineStyle& ls [[buffer(0)]]) {
    float d = abs(in.across);
    float a = clamp((ls.width * 0.5 + ls.feather * 0.5 - d) / ls.feather, 0.0, 1.0);
    if (in.dashed > 0.5 && fmod(in.along, ls.dash + ls.gap) > ls.dash) discard_fragment();
    return float4(ls.colour.rgb * a, a);
}

// MARK: the lights: two big bands of the living field, one glowing in from the top edge down to the Arctic Circle,
// one from the bottom edge up to 60°S, under the land, always moving, in teal, lime and blue.
struct AuroraU {
    float yNorth;    // map y of 66.5°N, where the top band ends
    float ySouth;    // map y of 60°S, where the bottom band ends
    float bottom;    // the map's bottom edge
    float strength;
    float pin;       // on a continent (0 to 1 with the move): each band's outer end on the screen's own edge (A1.17)
    float away;      // under Regions' selection menu (0 to 1): each band moved its own height out past its screen edge
};
vertex FullV fullVertex(uint vid [[vertex_id]], constant Cam& cam [[buffer(1)]]) {
    float2 p = float2((vid << 1) & 2, vid & 2);
    FullV o;
    o.position = float4(p * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
    o.s = p * cam.view;
    return o;
}

inline float hash21(float2 p) { p = fract(p * float2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
inline float vnoise(float2 p) {
    float2 i = floor(p), f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash21(i), hash21(i + float2(1, 0)), u.x), mix(hash21(i + float2(0, 1)), hash21(i + float2(1, 1)), u.x), u.y);
}
inline float fbm(float2 p) {
    float v = 0.0, a = 0.5;
    for (int i = 0; i < 4; i++) { v += a * vnoise(p); p = p * 2.03 + float2(17.1, 9.2); a *= 0.5; }
    return v;
}
// OKLab, so lime and blue never pass through olive mud (study 2.4)
inline float3 toLin(float3 c) { return pow(c, 2.2); }
inline float3 toSRGB(float3 c) { return pow(max(c, 0.0), 1.0 / 2.2); }
inline float3 oklab(float3 c) {
    float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
    float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
    float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
    l = pow(l, 1.0 / 3.0); m = pow(m, 1.0 / 3.0); s = pow(s, 1.0 / 3.0);
    return float3(0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
                  1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
                  0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s);
}
inline float3 fromOklab(float3 c) {
    float l = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;
    float m = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;
    float s = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;
    l = l * l * l; m = m * m * m; s = s * s * s;
    return float3(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
                  -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
                  -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
}

fragment float4 auroraFragment(FullV in [[stage_in]], constant Cam& cam [[buffer(1)]], constant AuroraU& au [[buffer(2)]]) {
    float2 m = cam.c + (in.s - cam.view * 0.5) / cam.k;    // the map point under this pixel
    float t = cam.time * 0.32;
    // the screen's own top and bottom in map units: a band reaches to the screen's edge when that edge is in view
    float screenTop = cam.c.y - cam.view.y * 0.5 / cam.k;
    float screenBottom = cam.c.y + cam.view.y * 0.5 / cam.k;
    float3 teal = oklab(toLin(float3(0.6902, 0.8784, 0.8039)));
    float3 lime = oklab(toLin(float3(0.8314, 0.8863, 0.2863)));
    float3 blue = oklab(toLin(float3(0.4706, 0.6824, 0.9725)));
    float3 total = float3(0.0);
    float alpha = 0.0;
    for (int band = 0; band < 2; band++) {
        // how far in from the band's outer edge (0, the edge of the world or of the screen) to its inner end (1)
        float outer = band == 0 ? mix(min(0.0, screenTop), screenTop, au.pin) : mix(max(au.bottom, screenBottom), screenBottom, au.pin);
        float inner = band == 0 ? au.yNorth : au.ySouth;
        // moved out past its edge by `away` of its own height (A6.5): a point sees the band as if it were that much
        // further along it
        float s = (m.y - outer) / (inner - outer) + au.away;
        if (s >= 1.0) continue;
        s = max(s, 0.0);
        // strongest at the edge, easing away to nothing at its end: a gradient coming out of the edge
        float body = pow(1.0 - smoothstep(0.0, 1.0, s), 0.85);
        // the living field: twice-warped noise, drifting slowly, in map space
        float2 p = m * float2(0.006, 0.012) + float2(float(band) * 7.3, 0.0);
        float2 w1 = float2(fbm(p * 2.0 + float2(t * 0.6, -t * 0.4)), fbm(p * 2.0 + float2(5.2, 1.3) - t * 0.5));
        float2 w2 = float2(fbm(p * 2.6 + w1 * 1.6 + float2(1.7, 9.2) + t * 0.3), fbm(p * 2.6 + w1 * 1.6 + float2(8.3, 2.8) - t * 0.35));
        float n1 = fbm(p * 3.0 + w2 * 1.8);
        float n2 = fbm(p * 2.2 - w1 * 1.2 + 3.1);
        // never one colour: teal and blue flowing through each other, lime coming through in places
        float3 col = mix(teal, blue, smoothstep(0.30, 0.72, n1));
        col = mix(col, lime, smoothstep(0.52, 0.80, n2) * 0.75);
        col = mix(col, teal, smoothstep(0.65, 0.9, n1) * 0.4);
        // the field's own light and shade, so it moves like lights and not like a flat sheet
        float glow = 0.62 + 0.55 * smoothstep(0.25, 0.85, n1 * 0.6 + n2 * 0.5);
        // the lights go on over the sea past the date line, the way the sea does (no fade at the world's sides)
        float a = body * glow * au.strength;
        total += toSRGB(fromOklab(col)) * a;
        alpha += a;
    }
    alpha = clamp(alpha, 0.0, 0.9);
    float3 rgb = alpha > 0.0001 ? total / max(alpha, 0.0001) : float3(0.0);
    // fine grain, so it never bands
    float grain = (hash21(in.s * 1.7 + fract(cam.time)) - 0.5) * 0.04;
    return float4((rgb + grain) * alpha, alpha);
}

// MARK: TOWN DOTS (7.4): a round dot of the town's grey (or lime, or blue), its radius in points, grown from its
// point by the zoom (never faded in)
struct TownDot { float2 p; float r; float pad; float4 colour; };
struct TownDotV { float4 position [[position]]; float2 local; float r; float4 colour; };
vertex TownDotV townDotVertex(uint vid [[vertex_id]], uint iid [[instance_id]],
                              const device TownDot* ds [[buffer(0)]],
                              constant Cam& cam [[buffer(1)]]) {
    TownDot d = ds[iid];
    float2 corner = float2((vid == 1 || vid == 3 || vid == 4) ? 1.0 : -1.0, (vid == 2 || vid == 4 || vid == 5) ? 1.0 : -1.0);
    float e = d.r + 1.0;
    TownDotV o;
    o.position = toClip(toScreen(d.p, cam) + corner * e, cam);
    o.local = corner * e;
    o.r = d.r;
    o.colour = d.colour;
    return o;
}
fragment float4 townDotFragment(TownDotV in [[stage_in]]) {
    float a = clamp(in.r - length(in.local) + 0.5, 0.0, 1.0);
    if (a <= 0.0) discard_fragment();
    return float4(in.colour.rgb * a, a);
}

// MARK: small places as diamonds, so they can be seen and tapped; all of them turn into their real shape at the same
// zoom
struct Diamond { float2 p; float2 pad; float4 colour; };
struct DiamondV { float4 position [[position]]; float2 local; float4 colour; };
vertex DiamondV diamondVertex(uint vid [[vertex_id]], uint iid [[instance_id]],
                              const device Diamond* ds [[buffer(0)]],
                              constant Cam& cam [[buffer(1)]]) {
    Diamond d = ds[iid];
    float2 corner = float2((vid == 1 || vid == 3 || vid == 4) ? 1.0 : -1.0, (vid == 2 || vid == 4 || vid == 5) ? 1.0 : -1.0);
    float extent = 7.0;
    float2 s = toScreen(d.p, cam) + corner * extent;
    DiamondV o;
    o.position = toClip(s, cam);
    // pad.x: its size (1 at rest); a diamond away from the continent you're on shrinks into its own point (A1.15)
    o.local = corner * extent / max(d.pad.x, 0.001);
    o.colour = d.colour;
    return o;
}
fragment float4 diamondFragment(DiamondV in [[stage_in]]) {
    float r = abs(in.local.x) + abs(in.local.y);     // points from the centre, diamond-wise
    // the rim is a full point, so a white diamond still reads on white land (Singapore beside Johor)
    float size = 5.8, edge = 1.1;
    // colour.a: how much of it is there (a diamond off the continent you're on goes with its borders)
    float a = clamp((size - r) / 0.7 + 0.5, 0.0, 1.0) * in.colour.a;
    if (a <= 0.0) discard_fragment();
    // the rim is 50% black, the inside the place's colour
    float inside = clamp((size - edge - r) / 0.7 + 0.5, 0.0, 1.0);
    float cover = inside + (1.0 - inside) * 0.5;
    return float4(in.colour.rgb * inside * a, cover * a);
}

// DEPTH OF FOCUS: with a card or the passport up, the map behind it goes softly out of focus, as through a lens
// focused on what is in front; the place the card is about stays sharp. The frame is drawn as always, then taken down
// to a quarter (its place's mask riding in alpha), blurred both ways, and laid back over.
struct LensV { float4 position [[position]]; float2 uv; };
vertex LensV lensVertex(uint vid [[vertex_id]]) {
    float2 p = float2((vid << 1) & 2, vid & 2);
    LensV o;
    o.position = float4(p * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
    o.uv = p;
    return o;
}
// the frame to a quarter: four bilinear taps, a 4 x 4 box; the kept place's mask into alpha
fragment float4 lensDown(LensV in [[stage_in]], texture2d<float> src [[texture(0)]], texture2d<float> mask [[texture(1)]],
                         sampler s [[sampler(0)]]) {
    float2 t = 1.0 / float2(src.get_width(), src.get_height());
    float3 c = src.sample(s, in.uv + t * float2(-1.0, -1.0)).rgb + src.sample(s, in.uv + t * float2(1.0, -1.0)).rgb
             + src.sample(s, in.uv + t * float2(-1.0, 1.0)).rgb + src.sample(s, in.uv + t * float2(1.0, 1.0)).rgb;
    return float4(c * 0.25, mask.sample(s, in.uv).r);
}
// one direction of a gaussian; u.xy the step in texels, u.z its sigma in texels
fragment float4 lensBlur(LensV in [[stage_in]], texture2d<float> src [[texture(0)]], sampler s [[sampler(0)]],
                         constant float4& u [[buffer(0)]]) {
    float2 t = u.xy / float2(src.get_width(), src.get_height());
    float sg = max(u.z, 0.5);
    float4 sum = float4(0.0);
    float wsum = 0.0;
    for (int i = -12; i <= 12; i++) {
        float x = float(i);
        float w = exp(-0.5 * x * x / (sg * sg));
        sum += src.sample(s, in.uv + t * x) * w;
        wsum += w;
    }
    return sum / wsum;
}
// laid back: the sharp frame where the place is (with a soft edge just outside its coast), the soft one elsewhere;
// u.x how far the lens has gone (0 to 1), u.y 1 when a place stays sharp
fragment float4 lensComposite(LensV in [[stage_in]], texture2d<float> sharp [[texture(0)]],
                              texture2d<float> soft [[texture(1)]], sampler s [[sampler(0)]],
                              constant float4& u [[buffer(0)]]) {
    float3 a = sharp.read(uint2(in.position.xy)).rgb;
    float4 b = soft.sample(s, in.uv);
    float keep = u.y > 0.5 ? smoothstep(0.06, 0.45, b.a) : 0.0;
    float k = smoothstep(0.0, 0.35, u.x) * (1.0 - keep);
    return float4(mix(a, b.rgb, k), 1.0);
}
